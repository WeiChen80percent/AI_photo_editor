# Local environments and secrets
.env
.env.*
!.env.example
.venv/
venv/

# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Flutter generated files
frontend/.dart_tool/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/**/ephemeral/
frontend/**/.plugin_symlinks/

# Runtime images and session records
outputs/*
!outputs/.gitkeep
comparisons/*
!comparisons/.gitkeep
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/results/*
!backend/storage/results/.gitkeep
backend/storage/sessions/*
!backend/storage/sessions/.gitkeep
backend/storage/masks/*
!backend/storage/masks/.gitkeep

# Logs and temporary files
*.log
*.tmp
*.temp
Thumbs.db
.DS_Store

# Large model assets are distributed through Hugging Face
models/*.gguf
models/*.safetensors
models/.cache/
models/Modelfile.runtime
